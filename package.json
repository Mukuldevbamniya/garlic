{
  "name": "garlic",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "lint": "oxlint $(find src server shared -type f \\( -name '*.ts' -o -name '*.tsx' \\))",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.92",
    "@ai-sdk/google": "^4.0.108",
    "@ai-sdk/react": "^4.0.161",
    "@hono/node-server": "^2.1.5",
    "ai": "^7.0.157",
    "hono": "^4.13.14",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "tsconfig": null
}
